---
// Финален CTA — стъклена текстова карта + форма за записване (Figma 3253:8789 / 3253:9082).
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__bg" aria-hidden="true">
    <img src="/assets/images/bg-city.jpg" alt="" width="1920" height="1083" loading="lazy" />
  </div>

  <div class="final-cta__inner container container--padded">
    <div class="final-cta__grid">
      <!-- Left: message card -->
      <div class="final-cta__info">
        <div class="final-cta__info-top">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <div class="final-cta__headings">
            <h2 class="final-cta__title" id="final-cta-title">
              Един ден може да промени следващите
              <span class="final-cta__title-accent">10 години</span>
              от кариерата ти.
            </h2>
            <p class="final-cta__subtext">Ела и разбери дали е за теб!</p>
          </div>
        </div>

        <div class="final-cta__logo" aria-hidden="true">
          <img src="/assets/icons/logo-icon.svg" alt="" width="60" height="60" loading="lazy" />
          <img src="/assets/icons/logo-text.svg" alt="" width="250" height="60" loading="lazy" />
        </div>
      </div>

      <!-- Right: lead form -->
      <form class="final-cta__form" id="zapazi" name="Брокер за 1 ден" novalidate>
        <div class="final-cta__fields">
          <div class="final-cta__field">
            <label class="final-cta__label" for="lead-name">Име<span aria-hidden="true">*</span></label>
            <input class="final-cta__input" type="text" id="lead-name" name="name" placeholder="Име" required autocomplete="name" aria-describedby="lead-name-error" />
            <p class="final-cta__error" id="lead-name-error" hidden></p>
          </div>
          <div class="final-cta__field">
            <label class="final-cta__label" for="lead-phone">Телефон<span aria-hidden="true">*</span></label>
            <input class="final-cta__input" type="tel" id="lead-phone" name="phone" placeholder="Телефон" required autocomplete="tel" aria-describedby="lead-phone-error" />
            <p class="final-cta__error" id="lead-phone-error" hidden></p>
          </div>
          <div class="final-cta__field">
            <label class="final-cta__label" for="lead-email">Имейл<span aria-hidden="true">*</span></label>
            <input class="final-cta__input" type="email" id="lead-email" name="email" placeholder="Имейл" required autocomplete="email" aria-describedby="lead-email-error" />
            <p class="final-cta__error" id="lead-email-error" hidden></p>
          </div>
          <div class="final-cta__field final-cta__field--message">
            <label class="final-cta__label" for="lead-message">Какво ви мотивира да опитате професията брокер за един ден?</label>
            <textarea class="final-cta__input final-cta__textarea" id="lead-message" name="message" placeholder="Вашето съобщение"></textarea>
          </div>
        </div>

        <div class="final-cta__consent">
          <label class="final-cta__checkbox">
            <input type="checkbox" name="consent" required />
            <span class="final-cta__consent-text">
              Давам съгласието си съобразно новите правила за
              <a href="/privacy" class="final-cta__consent-link">защита на личните данни</a>
            </span>
          </label>

          <button class="final-cta__submit btn" type="submit" disabled>Запази място</button>
          <p class="final-cta__status" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("zapazi") as HTMLFormElement | null;
  if (form) {
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
    const submit = form.querySelector<HTMLButtonElement>(".final-cta__submit");
    const status = form.querySelector<HTMLElement>(".final-cta__status");

    consent?.addEventListener("change", () => {
      if (submit) submit.disabled = !consent.checked;
    });

    // Полева валидация с български съобщения (заменя браузърните balloon-и)
    type Rule = { input: HTMLInputElement; error: HTMLElement; check: (v: string) => string | null };
    const rules: Rule[] = [];
    const addRule = (id: string, check: (v: string) => string | null) => {
      const input = form.querySelector<HTMLInputElement>(`#${id}`);
      const error = form.querySelector<HTMLElement>(`#${id}-error`);
      if (input && error) rules.push({ input, error, check });
    };

    addRule("lead-name", (v) => (v ? null : "Моля, въведи името си."));
    addRule("lead-phone", (v) => {
      if (!v) return "Моля, въведи телефонен номер.";
      const digits = v.replace(/\D/g, "");
      return /^[+\d][\d\s()./-]*$/.test(v) && digits.length >= 6 && digits.length <= 15
        ? null
        : "Моля, въведи валиден телефонен номер.";
    });
    addRule("lead-email", (v) => {
      if (!v) return "Моля, въведи имейл адрес.";
      return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? null : "Моля, въведи валиден имейл адрес.";
    });

    const setError = (rule: Rule, message: string | null) => {
      rule.error.textContent = message ?? "";
      rule.error.hidden = !message;
      rule.input.classList.toggle("final-cta__input--error", !!message);
      rule.input.setAttribute("aria-invalid", message ? "true" : "false");
    };

    rules.forEach((rule) => {
      rule.input.addEventListener("input", () => setError(rule, null));
      rule.input.addEventListener("blur", () => {
        if (rule.input.value.trim()) setError(rule, rule.check(rule.input.value.trim()));
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      let firstInvalid: Rule | null = null;
      for (const rule of rules) {
        const message = rule.check(rule.input.value.trim());
        setError(rule, message);
        if (message && !firstInvalid) firstInvalid = rule;
      }
      if (firstInvalid) {
        firstInvalid.input.focus();
        return;
      }

      const data = new FormData(form);
      let attribution: Record<string, string> = {};
      try {
        attribution = JSON.parse(localStorage.getItem("h2u_attribution") || "{}");
      } catch {}

      if (submit) {
        submit.disabled = true;
        submit.textContent = "Изпращане…";
      }
      if (status) status.hidden = true;

      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            phone: data.get("phone"),
            email: data.get("email"),
            message: data.get("message"),
            page: location.href,
            ...attribution,
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        location.assign("/thank-you");
      } catch {
        if (status) {
          status.textContent = "Нещо се обърка при изпращането. Моля, опитай отново или ни се обади на телефона по-долу.";
          status.hidden = false;
        }
        if (submit) {
          submit.disabled = false;
          submit.textContent = "Запази място";
        }
      }
    });
  }
</script>

<style>
  .final-cta {
    position: relative;
    width: 100%;
    overflow: clip;
  }

  .final-cta__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .final-cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 40%;
  }

  .final-cta__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gradient-cta-bg);
  }

  .final-cta__inner {
    position: relative;
    z-index: 1;
    padding-top: 5em;    /* 80px */
    padding-bottom: 5em;
  }

  .final-cta__grid {
    display: flex;
    align-items: stretch;
    gap: 2em; /* 32px */
  }

  /* --- Left message card --- */
  .final-cta__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3em;
    padding: 5em 3em 3em; /* 80/48/48px */
    border: 2px solid #ffffff;
    border-radius: var(--radius-xl);
    background: linear-gradient(270deg, rgba(255, 255, 255, 0.07) 1.76%, rgba(255, 255, 255, 0.04) 98.47%);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    overflow: hidden;
  }

  .final-cta__info-top {
    display: flex;
    flex-direction: column;
    gap: 2em; /* 32px */
  }

  .final-cta__headings {
    display: flex;
    flex-direction: column;
    gap: 1.5em; /* 24px */
  }

  .final-cta__title {
    font-size: 2.625em; /* 42px */
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .final-cta__title-accent {
    color: var(--color-primary);
  }

  .final-cta__subtext {
    font-size: 1.5em; /* 24px */
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text-secondary);
  }

  .final-cta__logo {
    display: flex;
    align-items: center;
    gap: 1.16em;
  }

  .final-cta__logo img {
    height: 3.75em; /* 60px */
    width: auto;
  }

  /* --- Form card --- */
  .final-cta__form {
    scroll-margin-top: 1.5em; /* breathing room when jumped to via #zapazi */
    width: 39.375em; /* 630px */
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 2.25em; /* 36px */
    justify-content: center;
    padding: 3.5em 3.75em; /* 56/60px */
    border: 1px solid #ffffff;
    border-radius: var(--radius-xl);
    background: linear-gradient(270deg, rgba(255, 255, 255, 0.42) 1.76%, rgba(255, 255, 255, 0.7) 98.47%);
    -webkit-backdrop-filter: blur(15px);
    backdrop-filter: blur(15px);
  }

  .final-cta__fields {
    display: flex;
    flex-direction: column;
    gap: 1.25em; /* 20px */
  }

  .final-cta__field {
    display: flex;
    flex-direction: column;
    gap: 0.75em; /* 12px */
  }

  .final-cta__label {
    padding-left: 1.14em; /* 16px at 14px font */
    font-size: 0.875em;   /* 14px */
    font-weight: 500;
    line-height: 1;
    color: var(--color-primary);
  }

  .final-cta__input {
    width: 100%;
    padding: 0.875em 1em; /* 14/16px */
    background: var(--color-bg-white);
    border: none;
    border-radius: 1.5em; /* 24px */
    font-size: 1em; /* 16px */
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-heading);
  }

  .final-cta__input::placeholder {
    color: var(--color-text-inactive);
  }

  .final-cta__input--error {
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }

  .final-cta__error {
    padding-left: 1.23em; /* aligns with the 16px label inset */
    font-size: 0.8125em; /* 13px */
    line-height: 1.4;
    color: var(--color-primary);
  }

  .final-cta__field--message {
    gap: 1em; /* 16px */
  }

  .final-cta__field--message .final-cta__label {
    line-height: 1.4;
  }

  .final-cta__textarea {
    min-height: 6.9375em; /* fills the 163px block from Figma */
    resize: vertical;
    box-shadow: 0px 3px 6.75px rgba(0, 0, 0, 0.05);
  }

  /* --- Consent + submit --- */
  .final-cta__consent {
    display: flex;
    flex-direction: column;
    gap: 2em; /* 32px */
  }

  .final-cta__checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.75em; /* 12px */
    max-width: 30em; /* 481px */
    cursor: pointer;
  }

  .final-cta__checkbox input {
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    width: 1em; /* 16px */
    height: 1em;
    margin-top: 0.25em;
    background: var(--color-bg-white);
    border: 1px solid var(--color-primary);
    border-radius: 0.1875em; /* 3px */
    box-shadow: 0px 3px 13.5px rgba(0, 0, 0, 0.05);
    cursor: pointer;
    display: grid;
    place-content: center;
  }

  .final-cta__checkbox input::before {
    content: "";
    width: 0.55em;
    height: 0.55em;
    transform: scale(0);
    transition: transform var(--transition-fast);
    background: var(--color-primary);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }

  .final-cta__checkbox input:checked::before {
    transform: scale(1);
  }

  .final-cta__consent-text {
    font-size: 0.875em; /* 14px */
    font-weight: 400;
    line-height: 1.5;
    color: #484848;
  }

  .final-cta__consent-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .final-cta__submit {
    width: 100%;
    box-shadow: var(--shadow-cta);
  }

  .final-cta__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .final-cta__status {
    font-size: 0.875em;
    color: var(--color-primary);
  }

  /* ---------------------------------------------------------------- */
  @media screen and (max-width: 991px) {
    .final-cta__inner {
      padding-top: 4em;    /* 64px */
      padding-bottom: 3.5em; /* 56px */
    }

    .final-cta__bg img {
      opacity: 0.3;
    }

    .final-cta__bg::after {
      background: linear-gradient(99deg, rgba(165, 196, 214, 0.28) 29.1%, rgba(252, 235, 236, 0.47) 65%);
    }

    .final-cta__grid {
      flex-direction: column;
      gap: 1em; /* 16px */
    }

    .final-cta__info {
      border-width: 1px;
      padding: 2em 1.5em 1.5em; /* 32/24/24px */
      gap: 1em;
    }

    .final-cta__info-top {
      gap: 1em; /* 16px */
    }

    .final-cta__headings {
      gap: 1em;
    }

    .final-cta__title {
      font-size: 1.75em; /* 28px */
    }

    .final-cta__subtext {
      font-size: 1.25em; /* 20px */
      color: var(--color-heading);
    }

    .final-cta__logo {
      display: none;
    }

    .final-cta__form {
      width: 100%;
      gap: 1.5em; /* 24px */
      padding: 2em 1.5em; /* 32/24px */
    }

    .final-cta__fields {
      gap: 1em; /* 16px */
    }

    .final-cta__label {
      font-size: 0.75em; /* 12px */
    }

    .final-cta__input {
      font-size: 0.75em; /* 12px */
      padding: 1.17em 1.33em;
    }

    .final-cta__consent {
      gap: 1.5em;
    }
  }
</style>
